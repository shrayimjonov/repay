use repay

db.createRole(
   {
     role: "repayAdmin",
     privileges: [
       { resource: { db: "repay", collection: "repay" }, actions: [ "find", "update", "insert", "remove" ] }
     ],
     roles: [
       { role: "read", db: "repay" }
     ]
   },
   { w: "majority" , wtimeout: 5000 }
)

db.createUser(
{ user: "mongopay", pwd: "${MONGO_PASSWORD}", roles: [ { role: "repayAdmin", db: "repay" } ]
} )

